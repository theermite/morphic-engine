{
  "name": "@theermite/morphic-engine",
  "version": "2.0.0-beta.7",
  "description": "Shinkofa Morphic Adaptation Engine — framework-agnostic core",
  "license": "AGPL-3.0-or-later OR MPL-2.0",
  "author": "Jean-Pierre Gonçalves (The Ermite)",
  "homepage": "https://github.com/theermite/morphic-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theermite/morphic-engine.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/theermite/morphic-engine/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "adaptation",
    "morphic",
    "neurodivergent",
    "shinkofa"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "LICENSE.AGPL-3.0-or-later",
    "LICENSE.MPL-2.0"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "effect": "3.21.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.8.0",
    "jsdom": "29.1.1",
    "style-dictionary": "5.4.1",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
    "idb": "8.0.3",
    "tweetnacl": "1.0.3",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.30",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "effect": "^3.21.2"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}

{
  "name": "@morphic/adapter",
  "version": "2.0.0-beta.1",
  "description": "Shinkofa Morphic Adaptation — React adapter (provider + hooks)",
  "license": "AGPL-3.0-or-later",
  "author": "Shinkofa & contributors",
  "homepage": "https://github.com/theermite/morphic-engine/tree/main/packages/adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theermite/morphic-engine.git",
    "directory": "packages/adapter"
  },
  "bugs": {
    "url": "https://github.com/theermite/morphic-engine/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "adaptation",
    "morphic",
    "react",
    "react-hooks",
    "shinkofa"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui.css": "./dist/ui/morphic-button.css",
    "./morphic.css": "./dist/ui/morphic-base.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.shinkofa.com/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "@morphic/engine": "^2.0.0-beta.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@morphic/engine": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
